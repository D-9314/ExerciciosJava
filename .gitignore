# --- Regras para manter configurações de SDK e Language Level ---

# 1. Ignora o conteúdo da pasta .idea por padrão em qualquer subpasta
**/.idea/*

# 2. Abre exceção para os arquivos de estrutura e compilação do projeto
!**/.idea/misc.xml
!**/.idea/compiler.xml

# 3. Garante que os arquivos de módulo (.iml) NÃO sejam ignorados
!**/*.iml


# --- Outros arquivos que devem continuar sendo ignorados ---

# Ignora arquivos de uso estritamente pessoal/local do IntelliJ
**/.idea/workspace.xml
**/.idea/usage.statistics.xml
**/.idea/dictionaries/
**/.idea/shelf/

# Pastas de build
out/
bin/
target/

# Sistema operacional
.DS_Store
Thumbs.db
